# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-a-different-random-secret

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/medassist
REDIS_URL=redis://localhost:6379/0
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=medassist
INFLUXDB_BUCKET=vitals

# EURI API Gateway (OpenAI-compatible SDK) — https://euron.one/euri
# Get your key at: https://euron.one/euri
EURI_API_KEY=                        # your-euri-api-key-here
EURI_BASE_URL=https://api.euron.one/api/v1/euri
OPENAI_ORG_ID=
OPENAI_MODEL_PRIMARY=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Medical report AI: default runs in a background thread after upload.
# Set REPORT_AI_SYNC=true to run analysis in the same HTTP request as upload (blocks until done; set a long upload timeout on the client).
# REPORT_AI_SYNC=false
#
# EURI-compatible APIs often reject response_format=json_object. Default is off; set to 1 only for official OpenAI.
# REPORT_AI_USE_JSON_RESPONSE_FORMAT=false

# Pinecone
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=medical-knowledge

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# S3 / MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=medassist-reports
S3_ENDPOINT_URL=                    # For MinIO in dev

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (Email) — https://resend.com (used first if RESEND_API_KEY is set)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SendGrid (Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Daily.co (Video)
DAILY_API_KEY=
DAILY_DOMAIN=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Encryption
PHI_ENCRYPTION_KEY=                 # AES-256 key for PHI encryption
